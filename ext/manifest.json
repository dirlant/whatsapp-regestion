{
  "manifest_version": 3,
  "name": "WA Envíos Masivos",
  "version": "1.0.0",
  "description": "Envío masivo en WhatsApp Web con intervalos y pausas inteligentes. Lee etiquetas y grupos.",
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "icons": { "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["lib/wppconnect-wa.js", "bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["ui.js"],
      "css": ["ui.css"],
      "run_at": "document_idle"
    }
  ]
}
